# ============================================================
# 电商 RAG 知识库智能问答系统 —— 环境配置模板
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略）
# ============================================================

# ---------- 基础 ----------
APP_NAME=ECommerceRAG
APP_ENV=dev                      # dev 时 CORS 全开、日志 DEBUG
SERVER_HOST=127.0.0.1            # 仅本机监听（安全）
SERVER_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 安全 ----------
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-64-char-random-hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456            # 首次启动 seed；登录后可在「修改密码」页修改

# ---------- 数据库与存储 ----------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.md,.txt

# ---------- LLM（阿里云百炼 DashScope 通义千问） ----------
# 注册与获取密钥：https://bailian.console.aliyun.com/ （模型服务灵积/百炼控制台）
# 一次注册同一把 Key 同时用于 LLM / embedding / rerank
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# rerank 原生协议端点（工作空间级 Key 需换成工作空间专属域名，与 BASE_URL 同域）
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-plus               # 默认模型（以百炼控制台实际开通的模型为准）
LLM_MODEL_STRONG=qwen-max         # 高质量模型（前端可切换；与默认相同时仅显示一个）
LLM_FALLBACK_MODEL=qwen-flash     # 限流时自动降级（可留空 = 不降级）
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=3             # 全局并发信号量（DashScope 有 RPM/TPM 限速）
LLM_THINKING_ENABLED=false        # 开启思考模式（前端可切换，返回 reasoning_content）

# ---------- Embedding（DashScope 通义千问） ----------
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10           # compatible-mode 单请求最多 10 条

# ---------- Rerank（DashScope，可关） ----------
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
# 工作空间网关为双段路径；公共云用 /services/rerank/text-rerank
RERANK_PATH=/services/rerank/text-rerank/text-rerank
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.35       # 相关度门槛（用金标集校准）

# ---------- 检索 ----------
VECTOR_SEARCH_K=10
BM25_SEARCH_K=10
RRF_K=60
CANDIDATE_K=12
FINAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_CONTEXT_CHARS=12000           # 上下文预算（约 8K token）

# ---------- 流水线开关 ----------
QUERY_REWRITE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.88     # 余弦相似度命中阈值（金标集校准）
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_MEMORY_AWARE=true  # 多轮对话时缓存 key 含历史摘要 hash
MEMORY_WINDOW_MESSAGES=6          # 保留最近 6 条原文进上下文
SUMMARY_TRIGGER_MESSAGES=10       # 超过后触发滚动摘要

# ---------- 限流（slowapi） ----------
RATE_LIMIT_GLOBAL=120/minute
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_LOGIN=5/minute

# ---------- 成本与后台 ----------
# qwen-plus 官方单价（元/百万 token），如换模型请同步更新
PRICE_INPUT_PER_1M=0.8
PRICE_OUTPUT_PER_1M=2.0
INGEST_WORKERS=2
